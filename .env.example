# MongoDB connection string (Atlas recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gamelink?retryWrites=true&w=majority

# JWT secret for signing tokens (use a strong random secret)
JWT_SECRET=your_super_secret_jwt_key_here

# JWT token expiration
JWT_EXPIRES_IN=7d

# Base URL of your application (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin user IDs (comma-separated, for promotion creation/deletion)
# ADMIN_USER_IDS=user_id_1,user_id_2
